# Copia a .env para desarrollo local (NO commitear .env).
ENV=dev
APP_PORT=8080
CORS_ORIGINS=https://chirimoyo.org,https://comunidad.chirimoyo.org,https://voluntarios.chirimoyo.org,http://localhost:3000
DB_NAME=(default)

# SMTP (Flask-Mail). Usado por los endpoints de contacto e inscripción de
# voluntarios. El password NO va en el repo: en Cloud Run se inyecta como secret.
# Sin credenciales el envío falla suave (best-effort) y la persistencia en
# Firestore sigue funcionando.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Buzón interno que recibe el aviso de cada mensaje de contacto.
CONTACTO_INBOX=contacto@chirimoyo.org
# Buzón interno que recibe el aviso de cada inscripción de voluntario.
VOLUNTARIOS_INBOX=voluntarios@chirimoyo.org

# Resumen semanal de jornadas para voluntarios suscritos (#voluntarios-suscripcion).
# Secreto compartido con apps/sitio (mismo valor en ambos, mismo patrón que
# REVALIDATE_SECRET) — protege POST /api/voluntarios/notificar-semana, que solo
# debe llamar el Route Handler de sitio, nunca el navegador.
NOTIFICAR_VOLUNTARIOS_SECRET=
# Base pública de este API, usada solo para construir el link de desuscripción
# dentro del correo (un humano lo abre en su navegador). api.chirimoyo.org no
# tiene DNS configurado (fuera de alcance, ver docs/guias/desplegar-sitio-
# produccion.md) — en prod usa la URL real de Cloud Run.
API_BASE_URL=http://localhost:8080
